[Unit]
Description=LFTR Next FastAPI ASGI service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lftr-next
EnvironmentFile=-/opt/lftr-next/.env
# Optional PostGIS env lives in /opt/lftr-next/.env; the service never logs the DSN.
ExecStart=/opt/lftr-next/.venv/bin/python -m app.main
Restart=always
RestartSec=5
User=lftr
Group=lftr

[Install]
WantedBy=multi-user.target
